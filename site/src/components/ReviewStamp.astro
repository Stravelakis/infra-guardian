---
// Review stamp (STANDARDS.md §7). Set in each page's front matter after
// ticking templates/docs/REVIEW-CHECKLIST.md:
//   checkedAgainst: v1.2.0
//   checkedOn: 2026-10-18
// A missing stamp shows a visible "not reviewed yet" note on purpose.
interface Props {
  checkedAgainst?: string;
  checkedOn?: string | Date;
}
const { checkedAgainst, checkedOn } = Astro.props;
const date = checkedOn instanceof Date ? checkedOn.toISOString().slice(0, 10) : checkedOn;
const ok = Boolean(checkedAgainst && date);
---
<p class:list={['review-stamp', { 'review-stamp--missing': !ok }]}>
  {ok ? (
    <>
      <span aria-hidden="true">✓</span> Checked against <strong>{checkedAgainst}</strong> on <time datetime={date}>{date}</time>
    </>
  ) : (
    <>
      <span aria-hidden="true">!</span> Not reviewed yet for this version
    </>
  )}
</p>
